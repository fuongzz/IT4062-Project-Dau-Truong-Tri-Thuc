{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: Build server",
            "type": "process",
            "command": "gcc",
            "args": [
                "-std=gnu11",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/src/server.c",
                "-lsodium",
                "-o",
                "${workspaceFolder}/src/server"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "C: Build client",
            "type": "process",
            "command": "gcc",
            "args": [
                "-std=gnu11",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/src/client.c",
                "-o",
                "${workspaceFolder}/src/client"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "C: Build project",
            "dependsOn": [
                "C: Build server",
                "C: Build client"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
