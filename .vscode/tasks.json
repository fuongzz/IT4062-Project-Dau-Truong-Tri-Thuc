{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: Build active file",
            "type": "process",
            "command": "gcc",
            "args": [
                "-std=gnu11",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-lm",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
